# Copy to .env and fill in. .env is gitignored.

# One password for every ClickHouse user (admin, loader, dbt, grafana, costlab).
# Local dev only - each tool still gets its own user so query_log can tell them apart.
CLICKHOUSE_PASSWORD=changeme
GRAFANA_ADMIN_PASSWORD=admin

# Kaggle API token (kaggle.com -> Settings -> API -> Create New Token).
# Alternatively drop kaggle.json into ~/.kaggle/
KAGGLE_USERNAME=
KAGGLE_KEY=

# Stream replay: which file and day the producer replays into Kafka.
# The backfill loads the days *before* REPLAY_DAY, so the stream picks up where history ends.
REPLAY_FILE=data/raw/2019-Oct.csv
REPLAY_DAY=2019-10-31
REPLAY_SPEED=1

# How often the transformer container runs `dbt run` (incremental).
DBT_INTERVAL_SECONDS=300
