<!-- Per-query limits for every user (they all use the default profile).
     Big GROUP BYs / sorts (fct_sessions on a full rebuild) spill to disk instead of
     pushing the server over its memory limit. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_bytes_before_external_group_by>800000000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>800000000</max_bytes_before_external_sort>
        </default>
    </profiles>
</clickhouse>
