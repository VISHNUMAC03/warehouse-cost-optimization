    {
      "type": "timeseries",
      "id": 11,
      "title": "Ingest latency (p50 / p95)",
      "description": "Seconds between the event happening and the row landing in ClickHouse. Mostly the consumer's batch interval; spikes mean the consumer fell behind.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
