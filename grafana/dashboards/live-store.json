          "rawSql": "/* grafana dashboard=live-store panel=top-categories */\nSELECT\n  splitByChar('.', toString(category_code))[1] AS category,\n  count() AS views\nFROM raw.events\nWHERE _source = 'stream'\n  AND $__timeFilter(event_time)\n  AND _loaded_at >= $__fromTime - INTERVAL 5 MINUTE\n  AND event_type = 'view'\n  AND category_code != ''\nGROUP BY category\nORDER BY views DESC\nLIMIT 8"
