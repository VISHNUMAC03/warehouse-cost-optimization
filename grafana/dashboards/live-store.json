      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=live-store panel=purchases-now */\nSELECT\n  countIf(event_time >= now() - INTERVAL 5 MINUTE) AS \"last 5 min\",\n  count() AS \"last 15 min\"\nFROM raw.events\nWHERE _source = 'stream'\n  AND event_time >= now() - INTERVAL 15 MINUTE\n  AND _loaded_at >= now64(3) - INTERVAL 20 MINUTE\n  AND event_type = 'purchase'"
        }
      ],
      "fieldConfig": {
