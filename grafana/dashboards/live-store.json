    {
      "type": "stat",
      "id": 7,
      "title": "Ingest latency",
      "description": "_loaded_at - event_time over the last 5 minutes: producer -> Kafka -> consumer batch -> ClickHouse. event_time is stored at second precision, so this reads up to ~1s high.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=live-store panel=ingest-latency-now */\nWITH dateDiff('millisecond', event_time, _loaded_at) / 1000 AS latency_s\nSELECT\n  quantile(0.5)(latency_s) AS p50,\n  quantile(0.95)(latency_s) AS p95\nFROM raw.events\nWHERE _source = 'stream'\n  AND event_time >= now() - INTERVAL 5 MINUTE\n  AND _loaded_at >= now64(3) - INTERVAL 10 MINUTE"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
