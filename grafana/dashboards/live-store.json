    {
      "type": "timeseries",
      "id": 12,
      "title": "Rows ingested per minute by Kafka partition",
      "description": "By load time rather than event time, so this shows what the consumer actually wrote each minute. Messages are keyed by user_session, so the 3 partitions should stay roughly even.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
