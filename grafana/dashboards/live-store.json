    {
      "type": "stat",
      "id": 6,
      "title": "View to purchase",
      "description": "Sessions that purchased / sessions that viewed a product, over the dashboard time range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 17,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=live-store panel=view-to-purchase */\nSELECT uniqExactIf(user_session, event_type = 'purchase')\n         / nullIf(uniqExactIf(user_session, event_type = 'view'), 0) AS conversion\nFROM raw.events\nWHERE _source = 'stream'\n  AND $__timeFilter(event_time)\n  AND _loaded_at >= $__fromTime - INTERVAL 5 MINUTE\n  AND event_type IN ('view', 'purchase')\n  AND user_session != ''"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
