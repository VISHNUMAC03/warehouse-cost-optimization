    {
      "type": "stat",
      "id": 2,
      "title": "Events / sec",
      "description": "Streamed events in the last 60 seconds, averaged per second. Bounded on _loaded_at (first column of the raw.events sort key) so this 10s-refresh query only reads the last few minutes of granules instead of the whole table.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=live-store panel=events-per-sec-now */\nSELECT count() / 60 AS events_per_sec\nFROM raw.events\nWHERE _source = 'stream'\n  AND event_time >= now() - INTERVAL 1 MINUTE\n  AND _loaded_at >= now64(3) - INTERVAL 6 MINUTE"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Purchases",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
