          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "/* grafana dashboard=live-store panel=ingest-latency */\nWITH dateDiff('millisecond', event_time, _loaded_at) / 1000 AS latency_s\nSELECT\n  $__timeInterval(event_time) AS time,\n  quantile(0.5)(latency_s) AS p50,\n  quantile(0.95)(latency_s) AS p95\nFROM raw.events\nWHERE _source = 'stream'\n  AND $__timeFilter(event_time)\n  AND _loaded_at >= $__fromTime - INTERVAL 5 MINUTE\nGROUP BY time\nORDER BY time"
