    {
      "type": "timeseries",
      "id": 9,
      "title": "Events / sec by type",
      "description": "Bounded on _loaded_at (first column of the raw.events sort key) so this 10s-refresh query only reads the last few minutes of granules instead of the whole table.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "interval": "10s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "/* grafana dashboard=live-store panel=events-per-sec */\nSELECT\n  $__timeInterval(event_time) AS time,\n  event_type,\n  count() / $__interval_s AS events_per_sec\nFROM raw.events\nWHERE _source = 'stream'\n  AND $__timeFilter(event_time)\n  AND _loaded_at >= $__fromTime - INTERVAL 5 MINUTE\nGROUP BY time, event_type\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
