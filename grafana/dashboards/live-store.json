          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=live-store panel=trending-products */\nSELECT\n  toString(product_id) AS product,\n  if(any(category_code) = '', '(none)', any(category_code)) AS category,\n  if(any(brand) = '', '(none)', any(brand)) AS brand,\n  countIf(event_type = 'view') AS views,\n  countIf(event_type = 'cart') AS carts,\n  countIf(event_type = 'purchase') AS purchases,\n  toFloat64(sumIf(price, event_type = 'purchase')) AS revenue\nFROM raw.events\nWHERE _source = 'stream'\n  AND event_time >= now() - INTERVAL 15 MINUTE\n  AND _loaded_at >= now64(3) - INTERVAL 20 MINUTE\nGROUP BY product_id\nORDER BY views DESC, purchases DESC\nLIMIT 15"
        }
