      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "/* grafana dashboard=live-store panel=rows-ingested */\nSELECT\n  toStartOfMinute(_loaded_at) AS time,\n  concat('partition ', toString(_kafka_partition)) AS partition,\n  count() AS rows\nFROM raw.events\nWHERE _source = 'stream'\n  AND $__timeFilter(_loaded_at)\nGROUP BY time, partition\nORDER BY time"
        }
      ],
