    {
      "type": "timeseries",
      "id": 7,
      "title": "Hourly revenue by category",
      "description": "Top 5 top-level categories by revenue in the range; everything else (including uncategorised) is 'other'.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "/* grafana dashboard=sales-overview panel=revenue-by-category-hourly */\nSELECT\n  $__timeInterval(event_time) AS time,\n  if(category_l1 IN (\n       SELECT category_l1\n       FROM analytics.fct_events\n       WHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n         AND $__timeFilter(event_time)\n         AND event_type = 'purchase'\n         AND category_l1 != 'unknown'\n       GROUP BY category_l1\n       ORDER BY sum(revenue) DESC\n       LIMIT 5\n     ), category_l1, 'other') AS category,\n  toFloat64(sum(revenue)) AS revenue\nFROM analytics.fct_events\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n  AND $__timeFilter(event_time)\n  AND event_type = 'purchase'\nGROUP BY time, category\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisSoftMin": 0,
            "barAlignment": -1,
            "insertNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
