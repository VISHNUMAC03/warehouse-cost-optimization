    {
      "type": "timeseries",
      "id": 6,
      "title": "Revenue per day",
      "description": "From agg_daily_category (pre-aggregated per day/category/brand), so it's cheap at any range. Today is partial.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "/* grafana dashboard=sales-overview panel=revenue-per-day */\nSELECT\n  toDateTime(event_date, 'UTC') AS time,\n  toFloat64(sum(revenue)) AS revenue,\n  sum(purchases) AS purchases\nFROM analytics.agg_daily_category\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\nGROUP BY event_date\nORDER BY event_date"
        }
      ],
      "fieldConfig": {
