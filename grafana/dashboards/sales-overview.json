          "queryType": "table",
          "rawSql": "/* grafana dashboard=sales-overview panel=revenue-total */\nSELECT toFloat64(sum(revenue)) AS revenue\nFROM analytics.fct_events\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n  AND $__timeFilter(event_time)\n  AND event_type = 'purchase'"
