          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=sales-overview panel=revenue-share-category */\nSELECT\n  if(category_l1 IN (\n       SELECT category_l1\n       FROM analytics.agg_daily_category\n       WHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n       GROUP BY category_l1\n       ORDER BY sum(revenue) DESC\n       LIMIT 7\n     ), category_l1, 'other') AS category,\n  toFloat64(sum(revenue)) AS revenue\nFROM analytics.agg_daily_category\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\nGROUP BY category\nORDER BY revenue DESC"
