    {
      "type": "piechart",
      "id": 3,
      "title": "Revenue by price band (USD)",
      "description": "Unit price of each purchased item, bucketed.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 11,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=product-performance panel=revenue-by-price-band */\nSELECT\n  multiIf(price < 50, 'under 50', price < 150, '50 - 150', price < 300, '150 - 300',\n          price < 600, '300 - 600', price < 1000, '600 - 1000', '1000 and up') AS band,\n  toFloat64(sum(revenue)) AS revenue\nFROM analytics.fct_events\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n  AND $__timeFilter(event_time)\n  AND event_type = 'purchase'\nGROUP BY band\nORDER BY min(price)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
