      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=product-performance panel=browse-not-buy */\nSELECT\n  toString(product_id) AS product,\n  if(any(category_code) = '', '(none)', any(category_code)) AS category,\n  any(brand) AS brand,\n  countIf(event_type = 'view') AS views,\n  countIf(event_type = 'purchase') AS purchases,\n  purchases / views AS conversion\nFROM analytics.fct_events\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n  AND $__timeFilter(event_time)\n  AND event_type IN ('view', 'purchase')\nGROUP BY product_id\nHAVING views >= 1000\nORDER BY conversion ASC, views DESC\nLIMIT 20"
        }
      ],
