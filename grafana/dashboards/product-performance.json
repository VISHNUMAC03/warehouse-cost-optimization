    {
      "type": "table",
      "id": 2,
      "title": "Top products by revenue",
      "description": "Sales from fct_events, product attributes (latest seen) from dim_products.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=product-performance panel=top-products */\nSELECT\n  toString(s.product_id) AS product,\n  if(p.category_code = '', '(none)', p.category_code) AS category,\n  p.brand AS brand,\n  toFloat64(p.last_price) AS price,\n  s.units AS units,\n  s.revenue AS revenue\nFROM\n(\n  SELECT product_id, count() AS units, toFloat64(sum(revenue)) AS revenue\n  FROM analytics.fct_events\n  WHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n    AND $__timeFilter(event_time)\n    AND event_type = 'purchase'\n  GROUP BY product_id\n  ORDER BY revenue DESC\n  LIMIT 20\n) AS s\nLEFT JOIN\n(\n  SELECT product_id, category_code, brand, last_price\n  FROM analytics.dim_products FINAL\n) AS p ON p.product_id = s.product_id\nORDER BY revenue DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
