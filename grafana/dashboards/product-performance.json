      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "/* grafana dashboard=product-performance panel=products-per-day */\nSELECT\n  toDateTime(event_date, 'UTC') AS time,\n  uniqExactIf(product_id, event_type = 'view') AS viewed,\n  uniqExactIf(product_id, event_type = 'purchase') AS sold\nFROM analytics.fct_events\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n  AND $__timeFilter(event_time)\n  AND event_type IN ('view', 'purchase')\nGROUP BY event_date\nORDER BY event_date"
        }
      ],
