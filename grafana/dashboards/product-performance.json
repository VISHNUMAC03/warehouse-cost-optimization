    {
      "type": "table",
      "id": 8,
      "title": "Catalog by category",
      "description": "From dim_products (latest attributes per product). Active = seen at least once in the time range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
