    {
      "type": "table",
      "id": 6,
      "title": "Viewed a lot, rarely bought",
      "description": "Products with at least 1,000 views in the range, lowest view -> purchase conversion first. Candidates for a pricing or listing review.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
