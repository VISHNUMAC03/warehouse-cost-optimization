      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=product-performance panel=catalog-by-category */\nSELECT\n  category_l1 AS category,\n  count() AS products,\n  countIf(last_seen_at >= $__fromTime) AS active_in_range,\n  uniqExact(brand) AS brands,\n  toFloat64(quantile(0.5)(last_price)) AS median_price,\n  toFloat64(max(last_price)) AS max_price\nFROM analytics.dim_products FINAL\nGROUP BY category\nORDER BY products DESC"
        }
      ],
