    {
      "type": "stat",
      "id": 2,
      "title": "Sessions",
      "description": "Sessions that started in the time range (empty user_session excluded).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=conversion-funnel panel=sessions-total */\nSELECT count() AS sessions\nFROM analytics.fct_sessions\nWHERE session_date >= toDate($__fromTime) AND session_date <= toDate($__toTime)\n  AND $__timeFilter(session_start)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
