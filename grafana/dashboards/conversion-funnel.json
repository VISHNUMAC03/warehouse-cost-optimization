    {
      "type": "bargauge",
      "id": 6,
      "title": "Sessions reaching each step",
      "description": "Sessions with at least one event of each type. Purchased can exceed Added to cart: in this dataset many purchases have no cart event in the same session.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=conversion-funnel panel=funnel-steps */\nSELECT\n  countIf(views > 0) AS \"Viewed a product\",\n  countIf(carts > 0) AS \"Added to cart\",\n  countIf(purchases > 0) AS \"Purchased\"\nFROM analytics.fct_sessions\nWHERE session_date >= toDate($__fromTime) AND session_date <= toDate($__toTime)\n  AND $__timeFilter(session_start)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
