    },
    {
      "type": "stat",
      "id": 4,
      "title": "Cart abandonment",
      "description": "Sessions that added something to the cart but did not buy, as a share of sessions with a cart event. Note: many purchase sessions in this dataset have no cart event at all.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=conversion-funnel panel=cart-abandonment */\nSELECT 1 - countIf(carts > 0 AND purchases > 0) / nullIf(countIf(carts > 0), 0) AS abandonment\nFROM analytics.fct_sessions\nWHERE session_date >= toDate($__fromTime) AND session_date <= toDate($__toTime)\n  AND $__timeFilter(session_start)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
