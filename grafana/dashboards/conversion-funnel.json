    {
      "type": "table",
      "id": 9,
      "title": "Funnel by category",
      "description": "Straight from fct_events, since the aggregates don't carry remove_from_cart (the 2019-Oct file has none, so removes is 0 there). Rates are per view event.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "/* grafana dashboard=conversion-funnel panel=funnel-by-category */\nSELECT\n  category_l1 AS category,\n  countIf(event_type = 'view') AS views,\n  countIf(event_type = 'cart') AS carts,\n  countIf(event_type = 'remove_from_cart') AS removes,\n  countIf(event_type = 'purchase') AS purchases,\n  carts / nullIf(views, 0) AS cart_rate,\n  purchases / nullIf(views, 0) AS purchase_rate,\n  toFloat64(sum(revenue)) AS revenue\nFROM analytics.fct_events\nWHERE event_date >= toDate($__fromTime) AND event_date <= toDate($__toTime)\n  AND $__timeFilter(event_time)\nGROUP BY category\nORDER BY views DESC"
        }
      ],
